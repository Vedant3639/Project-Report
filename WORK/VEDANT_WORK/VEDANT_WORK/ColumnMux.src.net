MM6 WD_BL YSR_BAR BL VDD P W=0.42 L=0.18 m=1
MM5 SA_BLB YSR BLB VDD P W=0.42 L=0.18 m=1
MM4 BL YSR SA_BL VDD P W=0.42 L=0.18 m=1
XI0 YSR_BAR VDD YSR VSS / CMOS_INV
