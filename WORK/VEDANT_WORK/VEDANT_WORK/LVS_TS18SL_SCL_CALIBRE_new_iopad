[
	effective M
	M = count()
]

//Reduce PARALLEL device calculations for cpacitors
//--------------------------------------------------

LVS REDUCE  C(CL) PARALLEL yes
[ 
	effective w, l
	P = sum( W * L ) // Sum of Wi * Li
	Q = sum( W / L ) // Sum of Wi / Li
	L = sqrt( P / Q ) // Effective L
	W= sum(W)
]

LVS REDUCE  C(CH) PARALLEL yes
[ 
	effective w, l
	P = sum( W * L ) // Sum of Wi * Li
	Q = sum( W / L ) // Sum of Wi / Li
