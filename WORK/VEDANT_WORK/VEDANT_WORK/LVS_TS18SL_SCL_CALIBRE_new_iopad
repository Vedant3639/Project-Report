// ****************************    MACROS   ************************
// *****************************************************************
//  !NOTE
//  In the 'res_prop' macro there are 2 ways to calculate 'R' one is:
//  Calculation for resistor ( not metal ) R.
//  rcon = (cres*pitch)/w
//  R=2*rcon + rsh*l/(w-dw)
//  L- resistor Body length
//  W- Width
//  Rc' - contact resistance per width (= typical single contact resistance* contact pitch).
//  The same macro is applicable for metal resistors only R_contact should be set to 0.
//  This code is commeneted out and should be used explicitly by the user by uncommenting the code

//  The second way is:
//  sheet_res*(L/W) it is the default resistance calculation. 
//----------------------------------------------------------------------

DMACRO res_prop seed_layer port_ sheet_res delta_W  cres cs_pitch {
 [

#ifndef RCX_run //(
  property L,W,R
#endif  //)
#ifdef RCX_run //(
  property L,W
#endif  //)
  W = PERIMETER_COINCIDE(seed_layer,port_)/2
  L = AREA(seed_layer)/W
  rcon= (cres*cs_pitch)/W
#ifndef RCX_run //(
   R = (2*rcon) + (sheet_res * L)/(W - delta_W)
//     R = sheet_res*(L/W)
#endif   //)
 ]
}

//=====================================================

DMACRO res_prop_rint seed_layer port_ sheet_res delta_W  cres cs_pitch  rint {
 [

#ifndef RCX_run //(
  property L,W,R
#endif  //)
#ifdef RCX_run //(
  property L,W
#endif  //)
  W = PERIMETER_COINCIDE(seed_layer,port_)/2
  L = AREA(seed_layer)/W
  rcon= (cres*cs_pitch)/W
  rend = rint/(W-delta_W) 
#ifndef RCX_run //(
   R = (2*rcon) + (2*rend) + (sheet_res * L)/(W - delta_W)
// R = sheet_res*(L/W)
#endif   //)
 ]
}



