# CALIBRE-LVS DISCREPANCY VIEWER TCL FILE 
# FILE: svdb/SRAM.dv
dv_start unmatched                                
dv_cell {SRAM} {SRAM} unmatched
dv_obj_count -transformed_nets {7 5} -transformed_inst {1 1} -transformed_port {0 0}
